rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin Supremo (SUPER_ADMIN_UID)
    function isAdmin() {
      return request.auth != null && request.auth.uid == "nqBV3Da1iqPbU46jGvO1ljBbIze2";
    }

    // -----------------------------------------------
    // USERS
    // Qualquer autenticado pode ler perfis (necessario para matching e explore).
    // Apenas o proprio usuario ou admin pode editar.
    // -----------------------------------------------
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // -----------------------------------------------
    // PROJECTS
    // Leitura publica (autenticada) para alimentar explore, matches e dashboards.
    // Criacao: apenas pelo dono (userId no documento deve bater com auth).
    // Edicao/exclusao: dono ou admin.
    // -----------------------------------------------
    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // -----------------------------------------------
    // MATCHES
    // Leitura: qualquer autenticado (necessario para explore e dashboard de matches).
    // Criacao: qualquer autenticado (gerado pelo sistema ou funcoes).
    // Update: qualquer autenticado (savedBy/ignoredBy via updateMatchAction).
    // Delete: apenas admin.
    // -----------------------------------------------
    match /matches/{matchId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // -----------------------------------------------
    // CONVERSATIONS
    // Leitura/update: apenas participantes ou admin.
    // Criacao: usuario deve estar na lista de participantes.
    // -----------------------------------------------
    match /conversations/{conversationId} {
      allow read: if request.auth != null && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null && (request.auth.uid in resource.data.participants || isAdmin());
    }

    // -----------------------------------------------
    // MESSAGES
    // Leitura: participantes da conversa vinculada ou admin.
    // Criacao: participantes da conversa vinculada.
    // Nota: usa get() para validar contra a conversa pai.
    // -----------------------------------------------
    match /messages/{messageId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants
      );
      allow create: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants;
    }

    // -----------------------------------------------
    // LEGAL INVITES
    // Convites de escritorios juridicos enviados por inventores.
    // Leitura: criador do convite, destinatario ou admin.
    // Criacao: qualquer autenticado (invitedBy deve ser o auth uid).
    // Update: criador ou admin (para alterar status).
    // -----------------------------------------------
    match /legal_invites/{inviteId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.invitedBy || isAdmin());
      allow create: if request.auth != null && request.auth.uid == request.resource.data.invitedBy;
      allow update: if request.auth != null && (request.auth.uid == resource.data.invitedBy || isAdmin());
      allow delete: if isAdmin();
    }

    // -----------------------------------------------
    // ANALYTICS & LOGS
    // -----------------------------------------------
    match /analytics_aggregation/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /logs_ai/{logId} {
      allow read: if isAdmin();
      allow write: if request.auth != null;
    }

    // -----------------------------------------------
    // NOTIFICATIONS
    // -----------------------------------------------
    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId 
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if isAdmin(); // Notifications are system-generated
    }

    // -----------------------------------------------
    // PHASE C: ASSETS IP & NDAs
    // -----------------------------------------------
    match /assets_ip/{assetId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
    }

    match /signed_ndas/{ndaId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.investorId || 
        request.auth.uid == resource.data.ownerId || 
        isAdmin()
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.investorId;
    }
  }
}

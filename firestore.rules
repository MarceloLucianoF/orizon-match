rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin Supremo (SUPER_ADMIN_UID)
    function isAdmin() {
      return request.auth != null && request.auth.uid == "nqBV3Da1iqPbU46jGvO1ljBbIze2";
    }

    // -----------------------------------------------
    // USERS
    // Qualquer autenticado pode ler perfis (necessario para matching e explore).
    // Apenas o proprio usuario ou admin pode editar.
    // -----------------------------------------------
    // -----------------------------------------------
    // MATCHES
    // Leitura: apenas participantes do match, dono do projeto, empresa relacionada, ICT ou admin.
    // Criacao: admin ou dono do projeto/empresa.
    // Update: apenas participantes do match, dono do projeto ou admin.
    // Delete: apenas admin.
    // -----------------------------------------------
    match /matches/{matchId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.targetUserId ||
        request.auth.uid == get(/databases/$(database)/documents/projects/$(resource.data.ownerProjectId)).data.userId ||
        (get(/databases/$(database)/documents/projects/$(resource.data.ownerProjectId)).data.orgId != null && 
         request.auth.uid in get(/databases/$(database)/documents/organizations/$(get(/databases/$(database)/documents/projects/$(resource.data.ownerProjectId)).data.orgId)).data.managers) ||
        (get(/databases/$(database)/documents/users/$(resource.data.targetUserId)).data.orgId != null && 
         request.auth.uid in get(/databases/$(database)/documents/organizations/$(get(/databases/$(database)/documents/users/$(resource.data.targetUserId)).data.orgId)).data.managers) ||
        isAdmin()
      );
      allow create: if request.auth != null && (
        request.auth.uid == request.resource.data.targetUserId ||
        request.auth.uid == get(/databases/$(database)/documents/projects/$(request.resource.data.ownerProjectId)).data.userId ||
        isAdmin()
      );
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.targetUserId ||
        request.auth.uid == get(/databases/$(database)/documents/projects/$(resource.data.ownerProjectId)).data.userId ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // -----------------------------------------------
    // CONVERSATIONS
    // Leitura/update: apenas participantes ou admin.
    // Criacao: usuario deve estar na lista de participantes.
    // -----------------------------------------------
    match /conversations/{conversationId} {
      allow read: if request.auth != null && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null && (request.auth.uid in resource.data.participants || isAdmin());
    }

    // -----------------------------------------------
    // MESSAGES
    // Leitura: participantes da conversa vinculada ou admin.
    // Criacao: participantes da conversa vinculada.
    // Nota: usa get() para validar contra a conversa pai.
    // -----------------------------------------------
    match /messages/{messageId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants
      );
      allow create: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants;
    }

    // -----------------------------------------------
    // LEGAL INVITES
    // Convites de escritorios juridicos enviados por inventores.
    // Leitura: criador do convite, destinatario ou admin.
    // Criacao: qualquer autenticado (invitedBy deve ser o auth uid).
    // Update: criador ou admin (para alterar status).
    // -----------------------------------------------
    match /legal_invites/{inviteId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.invitedBy || isAdmin());
      allow create: if request.auth != null && request.auth.uid == request.resource.data.invitedBy;
      allow update: if request.auth != null && (request.auth.uid == resource.data.invitedBy || isAdmin());
      allow delete: if isAdmin();
    }

    // -----------------------------------------------
    // ANALYTICS & LOGS
    // -----------------------------------------------
    match /analytics_aggregation/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /logs_ai/{logId} {
      allow read: if isAdmin();
      allow write: if request.auth != null;
    }

    // -----------------------------------------------
    // BILLING EVENTS (Stripe webhook idempotency)
    // -----------------------------------------------
    match /billing_events/{eventId} {
      allow read: if isAdmin();
      allow write: if request.auth != null || isAdmin();
    }

    // -----------------------------------------------
    // ENTERPRISE GOVERNANCE & AUDIT CENTER
    // -----------------------------------------------
    match /audit_logs/{logId} {
      // Users can read their own logs; Admins can read all.
      allow read: if request.auth != null && (isAdmin() || request.auth.uid == resource.data.actorId);
      // Only authenticated users can write audit logs.
      allow create: if request.auth != null;
      // Immutable: logs cannot be modified or deleted.
      allow update, delete: if false;
    }

    match /activity_events/{eventId} {
      // Anyone logged in can read the activity timeline.
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    match /domain_events/{eventId} {
      // Queue is internal/system-only. Only Admin/GCF can read or modify.
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // -----------------------------------------------
    // NOTIFICATIONS
    // -----------------------------------------------
    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId 
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if isAdmin(); // Notifications are system-generated
    }

    // -----------------------------------------------
    // PHASE D: ORGANIZATIONS & MULTI-TENANCY
    // -----------------------------------------------
    match /organizations/{orgId} {
      allow read: if request.auth != null && (request.auth.uid in resource.data.managers || isAdmin());
      allow update: if request.auth != null && request.auth.uid in resource.data.managers;
      allow create: if request.auth != null; // Requests for new orgs
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Allow managers to read profiles of users in their org
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == resource.data.orgId &&
        request.auth.uid in get(/databases/$(database)/documents/organizations/$(resource.data.orgId)).data.managers
      );
    }

    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (request.auth.uid == request.resource.data.userId || isAdmin());
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        isAdmin() ||
        (resource.data.orgId != null && request.auth.uid in get(/databases/$(database)/documents/organizations/$(resource.data.orgId)).data.managers)
      );

      // Subcollection: private/details
      match /private/details {
        allow read: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.userId ||
          isAdmin() ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionStatus == 'premium' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionStatus == 'enterprise' ||
          exists(/databases/$(database)/documents/signed_ndas/$(request.auth.uid + "_" + projectId)) ||
          (get(/databases/$(database)/documents/projects/$(projectId)).data.orgId != null && 
           request.auth.uid in get(/databases/$(database)/documents/organizations/$(get(/databases/$(database)/documents/projects/$(projectId)).data.orgId)).data.managers)
        );
        allow write: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.userId ||
          isAdmin() ||
          (get(/databases/$(database)/documents/projects/$(projectId)).data.orgId != null && 
           request.auth.uid in get(/databases/$(database)/documents/organizations/$(get(/databases/$(database)/documents/projects/$(projectId)).data.orgId)).data.managers)
        );
      }

      // Subcollection: vdr_files
      match /vdr_files/{fileId} {
        allow read: if request.auth != null && (
          resource.data.accessLevel == 'public' ||
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.userId ||
          isAdmin() ||
          exists(/databases/$(database)/documents/signed_ndas/$(request.auth.uid + "_" + projectId)) ||
          (get(/databases/$(database)/documents/projects/$(projectId)).data.orgId != null && 
           request.auth.uid in get(/databases/$(database)/documents/organizations/$(get(/databases/$(database)/documents/projects/$(projectId)).data.orgId)).data.managers)
        );
        allow write: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.userId ||
          isAdmin() ||
          (get(/databases/$(database)/documents/projects/$(projectId)).data.orgId != null && 
           request.auth.uid in get(/databases/$(database)/documents/organizations/$(get(/databases/$(database)/documents/projects/$(projectId)).data.orgId)).data.managers)
        );
      }

      // Subcollection: vdr_logs
      match /vdr_logs/{logId} {
        allow read: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.userId ||
          isAdmin() ||
          (get(/databases/$(database)/documents/projects/$(projectId)).data.orgId != null && 
           request.auth.uid in get(/databases/$(database)/documents/organizations/$(get(/databases/$(database)/documents/projects/$(projectId)).data.orgId)).data.managers)
        );
        allow create: if request.auth != null;
        allow update, delete: if isAdmin();
      }

      // Subcollection: due_diligence
      match /due_diligence/{itemId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.userId ||
          isAdmin() ||
          exists(/databases/$(database)/documents/signed_ndas/$(request.auth.uid + "_" + projectId)) ||
          (get(/databases/$(database)/documents/projects/$(projectId)).data.orgId != null && 
           request.auth.uid in get(/databases/$(database)/documents/organizations/$(get(/databases/$(database)/documents/projects/$(projectId)).data.orgId)).data.managers)
        );
      }
    }

    // -----------------------------------------------
    // DEALS (CRM Pipeline)
    // -----------------------------------------------
    match /deals/{dealId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.companyId ||
        request.auth.uid == get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.userId ||
        isAdmin()
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.companyId ||
        isAdmin()
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.companyId ||
        isAdmin()
      );
    }

    match /assets_ip/{assetId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (request.auth.uid == request.resource.data.ownerId || isAdmin());
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.ownerId || 
        isAdmin() ||
        (resource.data.orgId != null && request.auth.uid in get(/databases/$(database)/documents/organizations/$(resource.data.orgId)).data.managers)
      );
    }

    match /signed_ndas/{ndaId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.investorId || 
        request.auth.uid == resource.data.ownerId || 
        isAdmin() ||
        (resource.data.orgId != null && request.auth.uid in get(/databases/$(database)/documents/organizations/$(resource.data.orgId)).data.managers)
      );
      allow create: if request.auth != null && 
                    (request.auth.uid == request.resource.data.investorId || isAdmin()) &&
                    ndaId == (request.resource.data.investorId + "_" + request.resource.data.projectId);
    }
  }
}
